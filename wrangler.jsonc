{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logophilia-website",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "hugo --gc --minify",
    "environment": {
      "HUGO_VERSION": "0.165.0"
    }
  }
}
